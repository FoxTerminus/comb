{
    "train_batch_size": 32,
    "gradient_accumulation_steps": 4,
    "bf16": {
        "enabled": true
    },
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 5e-5,
            "weight_decay": 0.01
        }
    },
    "scheduler": {
        "type": "WarmupDecayLR",
        "params": {
            "warmup_min_lr": 0,
            "warmup_max_lr": 5e-5,
            "total_num_steps": 8000000
        }
    },
    "tensorboard": {
        "enabled": true,
        "job_name": "comb_ds0195_tp_compare"
    },
    "tensor_parallel": {
        "autotp_size": 1,
        "tp": {
            "tp_size": 1
        },
        "tensor_parallel": {
            "tp_size": 1
        },
        "partition_config": {
            "use_default_specs": false,
            "strict_mode": false,
            "layer_specs": [
                {
                    "patterns": [
                        ".*\\.(?:self_attn|cross_attn)\\.o_proj\\.weight$",
                        ".*\\.mlp\\.down_proj\\.weight$"
                    ],
                    "partition_type": "row"
                },
                {
                    "patterns": [
                        ".*\\.(?:self_attn|cross_attn)\\.[qkv]_proj\\.weight$",
                        ".*\\.mlp\\.(?:up|gate)_proj\\.weight$",
                        "^chunk_model\\.[kv]_proj\\.[0-9]+\\.weight$"
                    ],
                    "partition_type": "column"
                }
            ]
        }
    },
    "zero_optimization": {
        "stage": 2,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },
        "overlap_comm": true,
        "gather_16bit_weights_on_model_save": true
    }
}
